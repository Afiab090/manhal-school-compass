@echo off
chcp 65001 > nul
echo =========================================
echo    جاري رفع الملفات تلقائياً إلى GitHub...
echo =========================================

:: التأكد من وجود مستودع git
if not exist ".git" (
    echo [خطأ] هذا المجلد ليس مستودع Git! يرجى تهيئته أولاً باستخدام git init
    pause
    exit /b
)

:: إضافة جميع الملفات الجديدة والمعدلة
echo [1/3] إضافة الملفات...
git add .

:: تحديد رسالة الـ Commit (إذا لم يتم إدخال رسالة، سيتم استخدام تاريخ ووقت اليوم)
set commit_msg=تحديث تلقائي: %date% %time%
if not "%~1"=="" set commit_msg=%~1

echo [2/3] حفظ التغييرات (Commit)...
git commit -m "%commit_msg%"

:: الرفع إلى الفرع الافتراضي (غالباً main أو master)
echo [3/3] جاري الرفع إلى GitHub...
git push

echo =========================================
echo       تم رفع جميع الملفات بنجاح!
echo =========================================
pause